# Public template only. Copy this file to the ignored `.env` before adding real values.
# Real tenancy/account identifiers are allowed only in `.env`. Never store a token, OAuth
# material, client secret, service-principal credential, private key, or pepper here or in `.env`.

DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DBT_CONTROL_CATALOG=workspace
DBT_CONTROL_SCHEMA=default
DBT_PROJECT_CATALOG=bricksgdpr
DBT_SCHEMA_PREFIX=

# Shared by scripts/provision_identities.sh and scripts/validate_personas.sh.
DATABRICKS_CONFIG_PROFILE=bricksgdpr
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_EXPECTED_HOST=https://${DATABRICKS_HOST}
DATABRICKS_EXPECTED_CALLER=
DATABRICKS_IDENTITY_MODE=synthetic
PRIVACY_ADMIN_EMAIL=bricksgdpr.privacy.admin@example.invalid
RESTRICTED_USER_EMAIL=bricksgdpr.restricted.user@example.invalid
CASE_USER_EMAIL=bricksgdpr.case.user@example.invalid

# Required by scripts/validate_personas.sh; provisioning does not read it.
DATABRICKS_ACCOUNT_ID=

# Leave all three blank together only when creating genuinely absent groups for the first time.
# Pin all three for later provisioning runs; scripts/validate_personas.sh always requires them.
PRIVACY_ADMIN_GROUP_ID=
RESTRICTED_USER_GROUP_ID=
CASE_USER_GROUP_ID=

# Databricks Asset Bundle variable. It follows the reviewed warehouse value above when sourced.
BUNDLE_VAR_warehouse_id=${DATABRICKS_WAREHOUSE_ID}
